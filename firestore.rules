rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Every signed-in user can only read/write their own profile doc.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Anonymous landing-page analytics: create-only, no reads from clients.
    // View counts in the Firebase console instead.
    match /site_analytics/{docId} {
      allow create: if request.resource.data.keys().hasAll(["type", "path", "sessionId", "ts"])
        && request.resource.data.type == "pageview";
      allow read, update, delete: if false;
    }

    // One-vote 👍/👎 feedback from the landing widget. Create-only as well.
    match /site_feedback/{docId} {
      allow create: if request.resource.data.keys().hasAll(["vote", "path", "ts"])
        && request.resource.data.vote in ["up", "down"];
      allow read, update, delete: if false;
    }
  }
}
